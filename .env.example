# All variables are optional. TrafficLens works with zero configuration.

# Google API key with the PageSpeed Insights API enabled. Unlocks Core Web Vitals
# (lab + real-user field data). Without a key, Google's shared quota is usually exhausted.
PAGESPEED_API_KEY=

# Free key from https://www.domcop.com/openpagerank/ — adds an authority score (0–10).
OPENPAGERANK_API_KEY=

# Optional paid ranking data from DataForSEO Labs (https://dataforseo.com, pay as you go).
# Shows the keywords a site ranks for on Google with position, search volume and traffic,
# like Ahrefs. Each traffic report costs about $0.01 (cached for 24 hours per domain).
# Without it, top keywords are estimated for free from the homepage and search suggestions.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional, free: real monthly search volumes for top keywords from Google Ads Keyword
# Planner. Until all five are set, volumes are rough estimates from search suggestions.
# Needs a Google Ads manager account, a developer token with Basic access (apply in the
# API Center), and an OAuth client + refresh token with the https://www.googleapis.com/auth/adwords scope.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# The Google Ads account to run requests under (digits; dashes are fine).
GOOGLE_ADS_CUSTOMER_ID=
# Your manager (MCC) account ID, if the customer above is accessed through it.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# API version (default v25). Google retires versions about a year after release.
GOOGLE_ADS_API_VERSION=

# Hard cap on pages per site audit (default 200, max 1000).
MAX_AUDIT_PAGES=200

# Requests per minute per IP for the API (default 60). Audits are limited separately.
API_RATE_LIMIT_PER_MINUTE=60

# Development/testing only: allow fetching localhost and private network addresses.
# NEVER enable this on a public deployment (it would allow SSRF).
ALLOW_PRIVATE_HOSTS=false

# Public base URL of your deployment, used in sitemap.xml and robots.txt.
SITE_URL=

# ---- Accounts (optional) ----------------------------------------------------
# Sign-in with Google and/or GitHub via Auth.js. Login stays hidden behind a
# "coming soon" message until AUTH_SECRET and at least one provider are set.
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub: https://github.com/settings/developers → New OAuth App
#   Authorization callback URL: https://YOUR-DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---- Ads and plans (optional) -------------------------------------------------
# Google AdSense: ads show to visitors on the Free plan only; paid plans are ad-free.
# Both values are needed, and they're read at build time, so redeploy after changing them.
# Your publisher ID (AdSense > Account > Settings), e.g. ca-pub-1234567890123456.
# It also turns on /ads.txt, which AdSense requires.
NEXT_PUBLIC_ADSENSE_CLIENT=
# A responsive display ad unit's slot ID (AdSense > Ads > By ad unit), e.g. 1234567890
NEXT_PUBLIC_ADSENSE_SLOT=
# Until payments are added: accounts to treat as paid (ad-free), as email[:plan] pairs.
# Plan is pro or agency (default pro). Example: you@example.com:agency, friend@example.com
PAID_PLAN_EMAILS=

# ---- Contact form (optional) ------------------------------------------------
# Sends contact and waitlist messages through Resend (https://resend.com).
# Without these, the contact page links to GitHub issues instead.
RESEND_API_KEY=
# Inbox that receives the messages. Kept server-side; never shown on the site.
CONTACT_TO_EMAIL=
# Sender address on a domain you've verified in Resend. Defaults to Resend's
# test sender, which can only deliver to your own Resend account's email.
CONTACT_FROM_EMAIL=
